{
  "name": "{{ .profileName }}",
  "managementZone": "{{ .managementZone }}",
  "severityRules": [
    {
      "severityLevel": "AVAILABILITY",
      "delayInMinutes": 0,
      "tagFilterIncludeMode": "NONE"
    },
    {
      "severityLevel": "ERRORS",
      "delayInMinutes": 2,
      "tagFilterIncludeMode": "NONE"
    },
    {
      "severityLevel": "PERFORMANCE",
      "delayInMinutes": {{ .slowdownDelayMinutes }},
      "tagFilterIncludeMode": "NONE"
    },
    {
      "severityLevel": "RESOURCE_CONTENTION",
      "delayInMinutes": 30,
      "tagFilterIncludeMode": "INCLUDE_ANY",
      "tagFilter": ["tier:production"]
    },
    {
      "severityLevel": "CUSTOM_ALERT",
      "delayInMinutes": 0,
      "tagFilterIncludeMode": "NONE"
    }
  ],
  "eventFilters": [
    {
      "type": "PREDEFINED",
      "predefinedFilter": {
        "eventType": "SYNTHETIC_AVAILABILITY_ISSUE",
        "negate": false
      }
    },
    {
      "type": "CUSTOM",
      "customFilter": {
        "titleFilter": {
          "enabled": true,
          "operator": "CONTAINS",
          "value": "SLO",
          "negate": false,
          "caseSensitive": false
        }
      }
    }
  ]
}
